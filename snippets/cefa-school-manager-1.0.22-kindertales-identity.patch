+<?php
+/**
+ * Privacy-minimized CEFA identity metadata for KinderTales inquiries.
+ */
+
+defined('ABSPATH') || exit;
+
+/**
+ * Whether the guarded KinderTales identity extension is enabled.
+ */
+function cefa_sm_kindertales_identity_metadata_enabled(): bool {
+    if (!defined('CEFA_SM_KT_IDENTITY_METADATA_ENABLED')) {
+        return false;
+    }
+
+    return filter_var(
+        constant('CEFA_SM_KT_IDENTITY_METADATA_ENABLED'),
+        FILTER_VALIDATE_BOOLEAN
+    );
+}
+
+/**
+ * Return the governed attribution schema version sent to KinderTales.
+ */
+function cefa_sm_kindertales_attribution_schema_version(): string {
+    $version = defined('CEFA_SM_KT_ATTRIBUTION_SCHEMA_VERSION')
+        ? trim((string) constant('CEFA_SM_KT_ATTRIBUTION_SCHEMA_VERSION'))
+        : '1.0';
+
+    return preg_match('/^[A-Za-z0-9._-]{1,32}$/', $version) ? $version : '1.0';
+}
+
+/**
+ * Build identity-only metadata after Gravity Forms has saved the entry.
+ *
+ * The extension fails open for inquiry delivery: if either exact identifier
+ * is unavailable or invalid, it returns no additional metadata and leaves the
+ * existing KinderTales payload unchanged.
+ *
+ * @param array<string, mixed> $entry          Saved Gravity Forms entry.
+ * @param string               $event_field_id School Inquiry event-ID input.
+ * @param bool                 $enabled        Guarded rollout state.
+ * @param string               $schema_version Attribution contract version.
+ * @return array<string, string>
+ */
+function cefa_sm_build_kindertales_identity_metadata(
+    array $entry,
+    string $event_field_id,
+    bool $enabled,
+    string $schema_version
+): array {
+    if (!$enabled || $event_field_id === '') {
+        return [];
+    }
+
+    $event_id = trim((string) ($entry[$event_field_id] ?? ''));
+    $entry_id = (int) ($entry['id'] ?? 0);
+
+    if (
+        $entry_id <= 0
+        || $event_id === ''
+        || strlen($event_id) > 128
+        || !preg_match('/^[A-Za-z0-9._:-]+$/', $event_id)
+    ) {
+        return [];
+    }
+
+    $schema_version = trim($schema_version);
+
+    if (!preg_match('/^[A-Za-z0-9._-]{1,32}$/', $schema_version)) {
+        return [];
+    }
+
+    return [
+        'cefa_event_id'                   => $event_id,
+        'cefa_form_entry_id'              => (string) $entry_id,
+        'cefa_attribution_schema_version' => $schema_version,
+    ];
+}
